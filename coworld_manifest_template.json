  "player": [
    {
      "id": "profiler-echo",
      "name": "Profiler Echo",
      "type": "player",
      "image": "{{PROFILER_IMAGE}}",
      "run": [
        "python",
        "-m",
        "profiler.player.player",
        "--policy",
        "echo"
      ],
      "source_url": "https://github.com/Metta-AI/coworld-profiler/tree/main/profiler/player",
      "description": "Instrumented player that decodes, replies noop, and reports every stage's timestamps."
    },
    {
      "id": "profiler-busy-5ms",
      "name": "Profiler Busy 5ms",
      "type": "player",
      "image": "{{PROFILER_IMAGE}}",
      "run": [
        "python",
        "-m",
        "profiler.player.player",
        "--policy",
        "busy",
        "--think-cpu-ms",
        "5"
      ],
      "source_url": "https://github.com/Metta-AI/coworld-profiler/tree/main/profiler/player",
      "description": "Echo plus 5 ms of thread CPU per turn, to emulate real think time and expose CPU throttling."
    },
    {
      "id": "profiler-slow-start-20s",
      "name": "Profiler Slow Start 20s",
      "type": "player",
      "image": "{{PROFILER_IMAGE}}",
      "run": [
        "python",
        "-m",
