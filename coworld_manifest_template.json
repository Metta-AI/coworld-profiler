{
  "$schema": "https://raw.githubusercontent.com/Metta-AI/metta/main/packages/coworld/src/coworld/coworld_manifest_schema.json",
  "tags": [
    "profiling",
    "infrastructure",
    "multiplayer"
  ],
  "game": {
    "name": "profiler",
    "description": "A Coworld that exists only to measure: websocket round trips between game and player pods, connect stages, startup milestones, tick lag, action staleness, loop lag, CPU throttling, GC, and artifact write times.",
    "owner": "james@softmax.com",
    "player_runtime": "platform-hosted",
    "runnable": {
      "type": "game",
      "image": "{{PROFILER_IMAGE}}",
      "run": [
        "python",
        "-m",
        "profiler.game.server"
      ],
      "source_url": "https://github.com/Metta-AI/coworld-profiler/tree/main"
    },
    "config_schema": {
      "$defs": {
        "PayloadCell": {
          "properties": {
            "cell_id": {
              "minLength": 1,
              "title": "Cell Id",
              "type": "string"
            },
            "target_bytes": {
              "maximum": 4194304,
              "minimum": 64,
              "title": "Target Bytes",
              "type": "integer"
            },
            "warmup_ticks": {
              "minimum": 0,
              "title": "Warmup Ticks",
              "type": "integer"
            },
            "measure_ticks": {
              "minimum": 1,
              "title": "Measure Ticks",
              "type": "integer"
            }
          },
          "required": [
            "cell_id",
            "target_bytes",
            "warmup_ticks",
            "measure_ticks"
          ],
          "title": "PayloadCell",
          "type": "object"
        },
        "PlayerName": {
          "properties": {
            "name": {
              "minLength": 1,
              "title": "Name",
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "title": "PlayerName",
          "type": "object"
        }
      },
      "properties": {
        "tokens": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Tokens",
          "type": "array"
        },
        "players": {
          "items": {
            "$ref": "#/$defs/PlayerName"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Players",
          "type": "array"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "mode": {
          "default": "fixed_tick",
          "enum": [
            "fixed_tick",
            "blocking"
          ],
          "title": "Mode",
          "type": "string"
        },
        "step_seconds": {
          "default": 0.02,
          "exclusiveMinimum": 0,
          "maximum": 1.0,
          "title": "Step Seconds",
          "type": "number"
        },
        "decision_timeout_seconds": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Decision Timeout Seconds",
          "type": "number"
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/PayloadCell"
          },
          "minItems": 1,
          "title": "Cells",
          "type": "array"
        },
        "player_connect_timeout_seconds": {
          "default": 180,
          "minimum": 0,
          "title": "Player Connect Timeout Seconds",
          "type": "number"
        },
        "drain_seconds": {
          "default": 15.0,
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Drain Seconds",
          "type": "number"
        },
        "clock_probes_per_window": {
          "default": 8,
          "maximum": 64,
          "minimum": 0,
          "title": "Clock Probes Per Window",
          "type": "integer"
        },
        "resource_sample_seconds": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Resource Sample Seconds",
          "type": "number"
        }
      },
      "required": [
        "tokens",
        "players",
        "seed",
        "cells"
      ],
      "title": "GameConfig",
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "results_schema": {
      "$defs": {
        "CellResult": {
          "properties": {
            "cell_id": {
              "title": "Cell Id",
              "type": "string"
            },
            "payload_target_bytes": {
              "title": "Payload Target Bytes",
              "type": "integer"
            },
            "observation_bytes": {
              "title": "Observation Bytes",
              "type": "integer"
            },
            "measure_ticks": {
              "title": "Measure Ticks",
              "type": "integer"
            },
            "player_turn_duration": {
              "$ref": "#/$defs/Distribution"
            },
            "websocket_application_rtt": {
              "$ref": "#/$defs/Distribution"
            },
            "websocket_transport_residual": {
              "$ref": "#/$defs/Distribution"
            },
            "game_encode": {
              "$ref": "#/$defs/Distribution"
            }
          },
          "required": [
            "cell_id",
            "payload_target_bytes",
            "observation_bytes",
            "measure_ticks",
            "player_turn_duration",
            "websocket_application_rtt",
            "websocket_transport_residual",
            "game_encode"
          ],
          "title": "CellResult",
          "type": "object"
        },
        "Distribution": {
          "description": "Nearest-rank percentiles in seconds over a list of nanosecond samples.",
          "properties": {
            "count": {
              "title": "Count",
              "type": "integer"
            },
            "sum_s": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sum S"
            },
            "p50_s": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "P50 S"
            },
            "p90_s": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "P90 S"
            },
            "p99_s": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "P99 S"
            },
            "max_s": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Max S"
            }
          },
          "required": [
            "count",
            "sum_s",
            "p50_s",
            "p90_s",
            "p99_s",
            "max_s"
          ],
          "title": "Distribution",
          "type": "object"
        },
        "SlotResult": {
          "properties": {
            "player_slot": {
              "title": "Player Slot",
              "type": "integer"
            },
            "policy": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Policy"
            },
            "connected": {
              "title": "Connected",
              "type": "boolean"
            },
            "connect_attempts": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Connect Attempts"
            },
            "player_connect_dns_s": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Player Connect Dns S"
            },
            "player_connect_tcp_s": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Player Connect Tcp S"
            },
            "player_connect_upgrade_s": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Player Connect Upgrade S"
            },
            "player_connect_ready_s": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Player Connect Ready S"
            },
            "player_turn_duration": {
              "$ref": "#/$defs/Distribution"
            },
            "websocket_application_rtt": {
              "$ref": "#/$defs/Distribution"
            },
            "player_processing_duration": {
              "$ref": "#/$defs/Distribution"
            },
            "player_think_cpu": {
              "$ref": "#/$defs/Distribution"
            },
            "websocket_transport_residual": {
              "$ref": "#/$defs/Distribution"
            },
            "game_websocket_send_await": {
              "$ref": "#/$defs/Distribution"
            },
            "player_websocket_send_await": {
              "$ref": "#/$defs/Distribution"
            },
            "ping_rtt": {
              "$ref": "#/$defs/Distribution"
            },
            "observation_count": {
              "title": "Observation Count",
              "type": "integer"
            },
            "applied_count": {
              "title": "Applied Count",
              "type": "integer"
            },
            "late_discarded_count": {
              "title": "Late Discarded Count",
              "type": "integer"
            },
            "unanswered_count": {
              "title": "Unanswered Count",
              "type": "integer"
            },
            "dropped_before_send_count": {
              "title": "Dropped Before Send Count",
              "type": "integer"
            },
            "timeout_count": {
              "title": "Timeout Count",
              "type": "integer"
            },
            "timing_report_missing_count": {
              "title": "Timing Report Missing Count",
              "type": "integer"
            },
            "negative_residual_count": {
              "title": "Negative Residual Count",
              "type": "integer"
            },
            "clock_offset_ns": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Clock Offset Ns"
            },
            "clock_offset_lower_ns": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Clock Offset Lower Ns"
            },
            "clock_offset_upper_ns": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Clock Offset Upper Ns"
            },
            "clock_probe_delay_ns": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Clock Probe Delay Ns"
            },
            "clock_probe_valid_count": {
              "title": "Clock Probe Valid Count",
              "type": "integer"
            },
            "player_loop_lag_p99_s": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Player Loop Lag P99 S"
            },
            "player_artifact_publish_s": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Player Artifact Publish S"
            },
            "player_artifact_bytes": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Player Artifact Bytes"
            },
            "player_artifact_error": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Player Artifact Error"
            }
          },
          "required": [
            "player_slot",
            "policy",
            "connected",
            "connect_attempts",
            "player_connect_dns_s",
            "player_connect_tcp_s",
            "player_connect_upgrade_s",
            "player_connect_ready_s",
            "player_turn_duration",
            "websocket_application_rtt",
            "player_processing_duration",
            "player_think_cpu",
            "websocket_transport_residual",
            "game_websocket_send_await",
            "player_websocket_send_await",
            "ping_rtt",
            "observation_count",
            "applied_count",
            "late_discarded_count",
            "unanswered_count",
            "dropped_before_send_count",
            "timeout_count",
            "timing_report_missing_count",
            "negative_residual_count",
            "clock_offset_ns",
            "clock_offset_lower_ns",
            "clock_offset_upper_ns",
            "clock_probe_delay_ns",
            "clock_probe_valid_count",
            "player_loop_lag_p99_s",
            "player_artifact_publish_s",
            "player_artifact_bytes",
            "player_artifact_error"
          ],
          "title": "SlotResult",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "The results artifact. `extra=\"forbid\"` makes the generated schema close the object.",
      "properties": {
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scores": {
          "items": {
            "type": "number"
          },
          "title": "Scores",
          "type": "array"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "mode": {
          "title": "Mode",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "player_slot_count": {
